---
import BaseHead from '../components/BaseHead.astro';
import TerminalWindow from '../components/coming-soon/TerminalWindow.astro';
import TerminalLines from '../components/coming-soon/TerminalLines.astro';
import SocialLinks from '../components/coming-soon/SocialLinks.astro';
import TechBadges from '../components/coming-soon/TechBadges.astro';
import {
	FOOTER_JOKE,
	SOCIAL_LINKS,
	TECH_BADGES,
	TERMINAL_LINES,
	TERMINAL_TITLE,
} from '../components/coming-soon/coming-soon-content';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';
import '../components/coming-soon/terminal.css';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body class="cs-page">
		<main class="cs-wrap">
			<p class="cs-eyebrow">Portfolio v2 — under construction</p>
			<h1 class="sr-only">José María SE — portfolio coming soon</h1>
			<TerminalWindow title={TERMINAL_TITLE}>
				<TerminalLines lines={TERMINAL_LINES} />
				<div class="cs-meta">
					<TechBadges badges={TECH_BADGES} />
					<SocialLinks links={SOCIAL_LINKS} />
				</div>
			</TerminalWindow>
			<p class="cs-foot">{FOOTER_JOKE}</p>
		</main>
	</body>
</html>
